{
  "id": "./",
  "name": "Расчёт огнетушителей",
  "short_name": "Огнетушители",
  "description": "Проверка объекта на огнетушители по Приложению 3 к Правилам пожарной безопасности РК и СТ РК 1487-2006: расчёт по плану этажа, схема со знаками по ГОСТ 12.4.026-2015, перечень нарушений, отчёт в PDF. Работает без сети.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["productivity", "utilities", "business"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "icons/screens/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Помещения, схема этажа со знаками и результат на компьютере" },
    { "src": "icons/screens/narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Схема этажа на телефоне" }
  ],
  "shortcuts": [
    { "name": "Новый расчёт", "short_name": "Новый", "url": "./?action=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "План этажа по фото", "short_name": "План по фото", "url": "./?action=plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Нормы", "short_name": "Нормы", "url": "./?action=norms", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "plan", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp"] }]
    }
  },
  "file_handlers": [
    { "action": "./?inbox=file", "accept": { "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/webp": [".webp"] } }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
